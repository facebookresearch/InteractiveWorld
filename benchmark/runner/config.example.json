{
  "schema_version": "interactiveworld-runner-config/1.0",
  "tasks": {
    "ids": [],
    "categories": []
  },
  "assistant_control": "model",
  "assistant": {
    "provider": "openai",
    "model": "gpt-4.1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_s": 180,
    "tokens": 0,
    "frame_cap": 32
  },
  "human": {
    "provider": "openai-compatible",
    "model": "local-human-model",
    "base_url": "http://127.0.0.1:8000/v1",
    "timeout_s": 360,
    "tokens": 0,
    "frame_cap": 32
  },
  "runtime": {
    "num_gpus": 1,
    "seed": 0,
    "max_ticks": 0,
    "frame_budget": 24,
    "frames_per_tick": 4,
    "max_frames": 256,
    "frame_max_side": 512,
    "human_invalid_attempt_limit": 8,
    "human_http_attempt_limit": 3,
    "human_http_retry_backoff_s": 0.25,
    "io_capture": "auto",
    "graceful_exit": false,
    "fail_fast": false
  },
  "output": {
    "directory": "/tmp/interactiveworld-runs/example",
    "resume": false
  },
  "evaluation": {},
  "video": {
    "mode": "off",
    "fps": 4.0,
    "resolution": "1280x720",
    "captions": "speaker"
  }
}
